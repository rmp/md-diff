{
  "name": "md-diff",
  "version": "1.0.4",
  "description": "A web component for visual side-by-side markdown diffs",
  "main": "dist/md-diff.cjs.js",
  "module": "dist/md-diff.esm.js",
  "browser": "dist/md-diff.umd.js",
  "exports": {
    ".": {
      "browser": "./dist/md-diff.umd.js",
      "import": "./dist/md-diff.esm.js",
      "require": "./dist/md-diff.cjs.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmp/md-diff.git"
  },
  "keywords": [
    "web-component",
    "markdown",
    "diff",
    "side-by-side"
  ],
  "author": "Roger Pettett <rmp@psyphi.net>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "diff": "^8.0.3",
    "dompurify": "^3.4.7",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^20.9.0",
    "rollup": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
